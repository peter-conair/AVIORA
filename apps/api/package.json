    "dotenv": "^17.2.1",
    "nestjs-cls": "^6.0.1",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@aviora/config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "pino-pretty": "^13.1.1",
