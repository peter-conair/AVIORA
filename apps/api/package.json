{
  "name": "@aviora/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "prettier --check src test && eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --config vitest.integration.config.ts --coverage",
    "backfill:crm-bidx": "tsx scripts/backfill-crm-blind-index.ts"
  },
  "dependencies": {
    "@aviora/db": "workspace:*",
    "@aviora/shared": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.1.6",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.1",
    "ioredis": "^6.0.0",
    "nestjs-cls": "^6.0.1",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^9.0.5",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@aviora/config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@swc/core": "^1.16.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@vitest/coverage-v8": "^3.2.7",
    "pino-pretty": "^13.1.1",
    "typescript": "^5.9.2",
    "unplugin-swc": "^1.5.11",
    "vitest": "^3.2.4"
  }
}
