{
  "name": "aviora",
  "private": true,
  "version": "0.1.0",
  "description": "AVIORA \u2014 Multi-Tenant Membership & Healthy Living Growth OS",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "check": "turbo run lint typecheck test",
    "db:migrate": "pnpm --filter @aviora/db db:migrate",
    "db:seed": "pnpm --filter @aviora/db db:seed",
    "prepare": "husky",
    "db:restore-drill": "bash scripts/restore-drill.sh",
    "db:migration-rehearsal": "bash scripts/migration-rehearsal.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
