// AVIORA — base schema (Sprint 0: identity + tenancy + RBAC + audit + outbox)
// Conventions (docs/08-data-model.md):
//   snake_case tables/columns via @@map/@map · uuid v7 PKs · timestamptz(6) everywhere
//   every tenant-owned table has tenant_id NOT NULL + tenant-leading indexes
//   RLS policies live in migration SQL (see migrations/*/migration.sql)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("AVIORA_DATABASE_URL")
}

// ───────────────────────── Platform-scope tables (no RLS) ─────────────────────────

model Tenant {
  id              String   @id @default(uuid(7)) @db.Uuid
  code            String   @unique
  name            String
  slug            String   @unique
  legalName       String?  @map("legal_name")
  tenantType      String   @default("wellness_business") @map("tenant_type")
  status          String   @default("active")
  logoUrl         String?  @map("logo_url")
  primaryDomain   String?  @unique @map("primary_domain")
  customDomain    String?  @unique @map("custom_domain")
  country         String   @default("TH")
  timezone        String   @default("Asia/Bangkok")
  defaultLanguage String   @default("th") @map("default_language")
  defaultCurrency String   @default("THB") @map("default_currency")
  branding        Json?
  settings        Json?
  featureFlags    Json?    @map("feature_flags")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenantSettings    TenantSetting[]
  tenantMemberships TenantMembership[]
  members           Member[]
  roles             Role[]

  @@map("tenants")
}

model User {
  id           String    @id @default(uuid(7)) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  displayName  String?   @map("display_name")
  locale       String    @default("th")
  // Platform-level role (nullable = regular user). Platform roles are a fixed
  // platform-owned set; tenant roles are data-driven in `roles`.
  platformRole String?   @map("platform_role")
  status       String    @default("active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenantMemberships TenantMembership[]
  members           Member[]

  @@map("users")
}

// Global permission catalog — platform-owned reference data (no tenant_id).
model Permission {
  id           String   @id @default(uuid(7)) @db.Uuid
  key          String   @unique
  description  String?
  defaultScope String   @default("TENANT_ALL") @map("default_scope")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

// ───────────────────────── Tenant-owned tables (RLS FORCED) ─────────────────────────

model TenantSetting {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

// Link between a global User and a Tenant (spec §7). Member is the richer
// per-tenant participation record; this is the access/switcher record.
model TenantMembership {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  status    String    @default("active")
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt    DateTime? @map("left_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_memberships")
}

model Member {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  code        String?
  displayName String   @map("display_name")
  status      String   @default("active")
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant                     @relation(fields: [tenantId], references: [id])
  user              User                       @relation(fields: [userId], references: [id])
  memberRoles       MemberRole[]
  carts             Cart[]
  orders            Order[]
  subscriptions     Subscription[]
  referralsGiven    ReferralRelationship[]     @relation("referralsGiven")
  referralsReceived ReferralRelationship[]     @relation("referralsReceived")
  rankProgress      RankProgress[]
  rankHistory       RankHistory[]
  compUpline        CompensationRelationship[] @relation("compUpline")
  compDownline      CompensationRelationship[] @relation("compDownline")
  commissionEntries CommissionEntry[]
  rewardGrants      RewardGrant[]
  legalAcceptances  LegalAcceptance[]

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@map("members")
  businessGoals BusinessGoal[]
  weeklyUpdates WeeklyUpdate[]
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  rolePermissions RolePermission[]
  memberRoles     MemberRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

model RolePermission {
  tenantId     String   @map("tenant_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  scope        String   @default("TENANT_ALL")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([tenantId])
  @@map("role_permissions")
}

model MemberRole {
  tenantId   String   @map("tenant_id") @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([memberId, roleId])
  @@index([tenantId])
  @@map("member_roles")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  memberId   String?  @map("member_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  requestId  String   @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

// Transactional outbox (docs/11). Written in the same TX as the state change;
// relayed by the worker. Not RLS-forced: the relay is a cross-tenant system actor.
model DomainEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  eventName     String    @map("event_name")
  tenantId      String?   @map("tenant_id") @db.Uuid
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")

  @@index([processedAt, nextAttemptAt])
  @@index([tenantId, occurredAt])
  @@map("domain_events")
}

// ───────────────────────── Sprint 1 — platform-scope ─────────────────────────

model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBy String?   @map("replaced_by") @db.Uuid
  userAgent  String?   @map("user_agent")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

// Global entitlement catalog (capability keys) — platform reference data.
model Entitlement {
  id          String   @id @default(uuid(7)) @db.Uuid
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  planEntitlements PlanEntitlement[]

  @@map("entitlements")
}

// ───────────────────────── Sprint 1 — tenant-owned (RLS) ─────────────────────────

model MembershipPlan {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  code           String
  name           String
  description    String?
  membershipType String   @default("standard") @map("membership_type")
  price          Decimal  @default(0) @db.Decimal(12, 2)
  currency       String   @default("THB") @db.Char(3)
  billingCycle   String   @default("monthly") @map("billing_cycle")
  trialDays      Int      @default(0) @map("trial_days")
  benefits       Json?
  limits         Json?
  status         String   @default("active")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  planEntitlements PlanEntitlement[]
  memberships      Membership[]
  offeringPrices   OfferingPlanPrice[]

  @@unique([tenantId, code])
  @@map("membership_plans")
}

model PlanEntitlement {
  tenantId      String   @map("tenant_id") @db.Uuid
  planId        String   @map("plan_id") @db.Uuid
  entitlementId String   @map("entitlement_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plan        MembershipPlan @relation(fields: [planId], references: [id])
  entitlement Entitlement    @relation(fields: [entitlementId], references: [id])

  @@id([planId, entitlementId])
  @@index([tenantId])
  @@map("plan_entitlements")
}

model Membership {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  memberId         String    @map("member_id") @db.Uuid
  planId           String    @map("plan_id") @db.Uuid
  status           String    @default("active")
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  trialEndsAt      DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  currentPeriodEnd DateTime? @map("current_period_end") @db.Timestamptz(6)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan MembershipPlan @relation(fields: [planId], references: [id])

  @@index([tenantId, memberId, status])
  @@map("memberships")
}

model Invitation {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  email             String
  planId            String?   @map("plan_id") @db.Uuid
  invitedByMemberId String?   @map("invited_by_member_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  status            String    @default("pending")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt        DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, email])
  @@map("invitations")
}

/// Corporate wellness (docs/45). A sponsor — an employer, usually — pays for a
/// number of memberships on a plan, and employees consume them.
///
/// What a sponsor can SEE about the people they pay for is deliberately narrow:
/// participation, never health. Health is SELF-scoped with no admin override
/// (docs/13), and paying for somebody's membership is not consent to see their
/// sleep (docs/45 §1).
model SponsorshipPool {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  /// The plan a seat grants. One pool, one plan — a pool that granted several
  /// would make "how many seats are left" a question with no single answer.
  planId      String   @map("plan_id") @db.Uuid
  seats       Int
  sponsorName String?  @map("sponsor_name")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  seatRows SponsoredSeat[]

  @@unique([tenantId, code])
  @@map("sponsorship_pools")
}

/// One seat out of a pool. Taken when the invitation is SENT, not when it is
/// accepted (docs/45 §2): assigning on acceptance lets a sponsor with 100 seats
/// invite 200 people, and the hundred who arrive second are refused at the door
/// by a platform that told their employer everything was fine.
model SponsoredSeat {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  poolId       String    @map("pool_id") @db.Uuid
  /// Set when the invitation is accepted; null while the seat is only reserved.
  memberId     String?   @map("member_id") @db.Uuid
  invitationId String?   @map("invitation_id") @db.Uuid
  assignedAt   DateTime? @map("assigned_at") @db.Timestamptz(6)
  releasedAt   DateTime? @map("released_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  pool SponsorshipPool @relation(fields: [poolId], references: [id], onDelete: Cascade)

  @@index([tenantId, poolId, releasedAt])
  @@index([tenantId, memberId])
  @@map("sponsored_seats")
}

/// A partner organisation (docs/46). Not a member, and deliberately not
/// modelled as one: partner staff must not appear in member counts, receive
/// member communications, or reach a route that returns member data.
model Partner {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  code         String
  name         String
  contactEmail String?  @map("contact_email")
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users     PartnerUser[]
  referrals PartnerReferral[]

  @@unique([tenantId, code])
  @@map("partners")
}

/// A person at the partner who can sign in to the portal. They have a User row
/// — that is how they log in — and no Member row, which is the entire point.
model PartnerUser {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  partnerId String   @map("partner_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, partnerId])
  @@map("partner_users")
}

/// Who a partner invited, and who actually joined.
///
/// A row is written when the partner sends the invitation, with `member_id`
/// null — invited but not yet joined, the same reserve-then-assign shape
/// sponsored seats use. An outbox handler fills `member_id` in when the
/// invitation is accepted. There is no route by which a partner claims somebody
/// they did not bring, because these numbers are the basis of what they get
/// paid (docs/46 §2).
model PartnerReferral {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  partnerId    String   @map("partner_id") @db.Uuid
  /// Null while the invitation is outstanding.
  memberId     String?  @map("member_id") @db.Uuid
  invitationId String?  @map("invitation_id") @db.Uuid
  joinedAt     DateTime? @map("joined_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  /// One member is attributed to one partner. Two partners claiming the same
  /// person is an argument about money that nobody can settle afterwards.
  @@unique([tenantId, memberId])
  @@index([tenantId, partnerId])
  @@map("partner_referrals")
}

model Team {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  parentTeamId String?  @map("parent_team_id") @db.Uuid
  teamType     String   @default("team") @map("team_type")
  code         String
  name         String
  description  String?
  status       String   @default("active")
  visibility   String   @default("private")
  settings     Json?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Team?  @relation("TeamParent", fields: [parentTeamId], references: [id])
  children Team[] @relation("TeamParent")

  teamMemberships TeamMembership[]
  teamLeaderships TeamLeadership[]

  @@unique([tenantId, code])
  @@index([tenantId, parentTeamId])
  @@map("teams")
}

model TeamClosure {
  tenantId         String @map("tenant_id") @db.Uuid
  ancestorTeamId   String @map("ancestor_team_id") @db.Uuid
  descendantTeamId String @map("descendant_team_id") @db.Uuid
  depth            Int

  @@id([ancestorTeamId, descendantTeamId])
  @@index([tenantId, descendantTeamId])
  @@map("team_closure")
}

model TeamMembership {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  memberId       String    @map("member_id") @db.Uuid
  membershipType String    @default("member") @map("membership_type")
  status         String    @default("active")
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt         DateTime? @map("left_at") @db.Timestamptz(6)
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id])

  @@unique([teamId, memberId])
  @@index([tenantId, memberId])
  @@map("team_memberships")
}

model TeamLeadership {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  memberId       String    @map("member_id") @db.Uuid
  leadershipRole String    @default("PRIMARY_LEADER") @map("leadership_role")
  isPrimary      Boolean   @default(true) @map("is_primary")
  status         String    @default("active")
  effectiveFrom  DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id])

  @@index([tenantId, teamId, status])
  @@map("team_leaderships")
}

model Goal {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  memberId    String    @map("member_id") @db.Uuid
  title       String
  description String?
  category    String    @default("personal")
  status      String    @default("active")
  targetDate  DateTime? @map("target_date") @db.Date
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, memberId, status])
  @@map("goals")
}

model Course {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  title       String
  description String?
  status      String   @default("published")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lessons Lesson[]

  @@unique([tenantId, code])
  @@map("courses")
}

model Lesson {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  courseId  String   @map("course_id") @db.Uuid
  order     Int
  title     String
  content   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course Course @relation(fields: [courseId], references: [id])

  @@unique([courseId, order])
  @@map("lessons")
}

model LearningProgress {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  memberId           String    @map("member_id") @db.Uuid
  courseId           String    @map("course_id") @db.Uuid
  status             String    @default("in_progress")
  completedLessonIds Json      @default("[]") @map("completed_lesson_ids")
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([memberId, courseId])
  @@index([tenantId, memberId])
  @@map("learning_progress")
}

// ───────────────────────── Sprint 3 — CRM · notifications · audit ─────────────────────────

/// Tenant-configurable CRM pipeline (spec §34) — never hard-code stages.
model PipelineStage {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  code       String
  name       String
  order      Int
  isTerminal Boolean  @default(false) @map("is_terminal")
  isWon      Boolean  @default(false) @map("is_won")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  leads Lead[]

  @@unique([tenantId, code])
  @@index([tenantId, order])
  @@map("pipeline_stages")
}

model Lead {
  id                  String    @id @default(uuid(7)) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  ownerMemberId       String    @map("owner_member_id") @db.Uuid
  stageId             String?   @map("stage_id") @db.Uuid
  name                String
  email               String?
  phone               String?
  emailBidx           String?   @map("email_bidx")
  phoneBidx           String?   @map("phone_bidx")
  source              String?
  notes               String?
  status              String    @default("open")
  // The two paper name lists (docs/56). A person can be on both — someone you
  // would happily sponsor is usually also someone who would buy — so these are
  // two flags rather than one "kind" that would force a second row and trip
  // the duplicate check (docs/55).
  onSponsorList       Boolean   @default(false) @map("on_sponsor_list")
  onCustomerList      Boolean   @default(false) @map("on_customer_list")
  /// Ratings per criterion key, 1..5. Shared with both lists on purpose:
  /// `money` and `relation` are one fact about a person, not two.
  scores              Json?
  /// Derived from `scores`, stored so the report can rank in the database
  /// rather than pulling every lead into memory to sort it.
  sponsorScore        Int       @default(0) @map("sponsor_score")
  customerScore       Int       @default(0) @map("customer_score")
  /// Which Memory Jogger prompt produced this name, so the report can say
  /// which prompts work for this person (docs/56 §6).
  joggerPrompt        String?   @map("jogger_prompt")
  convertedCustomerId String?   @map("converted_customer_id") @db.Uuid
  convertedAt         DateTime? @map("converted_at") @db.Timestamptz(6)
  lastContactAt       DateTime? @map("last_contact_at") @db.Timestamptz(6)
  metadata            Json?
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  stage        PipelineStage? @relation(fields: [stageId], references: [id])
  followUps    FollowUp[]
  interactions Interaction[]

  @@index([tenantId, ownerMemberId, status])
  @@index([tenantId, stageId])
  // Contact lookup goes through the blind index, not the column, so it keeps
  // working when the column is ciphertext (docs/54).
  @@index([tenantId, emailBidx])
  @@index([tenantId, phoneBidx])
  // The name-list screens read one list ordered by its own score.
  @@index([tenantId, onSponsorList, sponsorScore])
  @@index([tenantId, onCustomerList, customerScore])
  @@map("leads")
}

model Customer {
  id                  String   @id @default(uuid(7)) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  ownerMemberId       String   @map("owner_member_id") @db.Uuid
  memberId            String?  @map("member_id") @db.Uuid
  name                String
  email               String?
  phone               String?
  emailBidx           String?  @map("email_bidx")
  phoneBidx           String?  @map("phone_bidx")
  status              String   @default("active")

  /* ── the customer index card (docs/66) ─────────────────────────────────── */
  /// ABO#, membership number — the business's own account number for them.
  externalCode        String?   @map("external_code")
  /// When that membership runs out, so a renewal can be seen coming.
  membershipExpiresAt DateTime? @map("membership_expires_at") @db.Date
  /// Date of birth. Kept as a date because the only thing it is for is knowing
  /// when to send a greeting, and an age would be stale within a year.
  birthDate           DateTime? @map("birth_date") @db.Date
  /// A national identity number, ALWAYS encrypted at rest (docs/66 §3). The
  /// column name says so, because a column called `idNumber` holding
  /// ciphertext is how somebody later writes plaintext into it.
  idNumberEncrypted   String?   @map("id_number_encrypted")
  /// The NOTE box on the card.
  note                String?

  convertedFromLeadId String?  @map("converted_from_lead_id") @db.Uuid
  metadata            Json?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  followUps    FollowUp[]
  interactions Interaction[]

  @@index([tenantId, ownerMemberId, status])
  @@index([tenantId, emailBidx])
  @@index([tenantId, phoneBidx])
  @@map("customers")
  consents CustomerConsent[]
  photos   ProgressPhoto[]
  monthOrders CustomerMonthOrder[]
}

model FollowUp {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  ownerMemberId String    @map("owner_member_id") @db.Uuid
  leadId        String?   @map("lead_id") @db.Uuid
  customerId    String?   @map("customer_id") @db.Uuid
  title         String
  notes         String?
  dueAt         DateTime  @map("due_at") @db.Timestamptz(6)
  status        String    @default("open")
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  lead     Lead?     @relation(fields: [leadId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId, ownerMemberId, status, dueAt])
  @@map("follow_ups")
}

model Interaction {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  actorMemberId String   @map("actor_member_id") @db.Uuid
  leadId        String?  @map("lead_id") @db.Uuid
  customerId    String?  @map("customer_id") @db.Uuid
  channel       String   @default("note")
  summary       String
  occurredAt    DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  metadata      Json?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lead     Lead?     @relation(fields: [leadId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId, leadId, occurredAt])
  @@index([tenantId, customerId, occurredAt])
  @@map("interactions")
}

model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  memberId  String    @map("member_id") @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, memberId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  type      String
  inApp     Boolean  @default(true) @map("in_app")
  email     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([memberId, type])
  @@index([tenantId, memberId])
  @@map("notification_preferences")
}

/// Per-handler completion ledger (docs/11 §idempotency): a retried event must
/// not re-run handlers that already succeeded, and one failing handler must not
/// block the others.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, handler])
  @@map("processed_events")
}

// ───────────────────────── Sprint 4 — knowledge graph · AI ─────────────────────────
// Knowledge is layered (spec §29): tenant_id NULL = GLOBAL knowledge readable by
// every tenant; tenant_id set = that tenant's own knowledge. RLS policies for
// these tables therefore read `tenant_id IS NULL OR tenant_id = app.tenant_id`,
// while writes still require a matching tenant_id.

model HealthGoal {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  code         String
  name         String
  description  String?
  order        Int      @default(0)
  translations Json?
  searchText   String   @default("") @map("search_text")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  topics HealthGoalTopic[]

  @@map("health_goals")
}

model Topic {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  code         String
  name         String
  summary      String?
  translations Json?
  searchText   String   @default("") @map("search_text")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  healthGoals HealthGoalTopic[]
  ingredients TopicIngredient[]
  articles    ArticleTopic[]

  @@map("topics")
}

model HealthGoalTopic {
  healthGoalId String @map("health_goal_id") @db.Uuid
  topicId      String @map("topic_id") @db.Uuid

  healthGoal HealthGoal @relation(fields: [healthGoalId], references: [id])
  topic      Topic      @relation(fields: [topicId], references: [id])

  @@id([healthGoalId, topicId])
  @@map("health_goal_topics")
}

model Ingredient {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  code         String
  name         String
  summary      String?
  safetyNotes  String?  @map("safety_notes")
  translations Json?
  searchText   String   @default("") @map("search_text")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  topics   TopicIngredient[]
  articles ArticleIngredient[]
  products ProductIngredient[]
  evidence EvidenceReference[]

  @@map("ingredients")
}

model TopicIngredient {
  topicId      String @map("topic_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid

  topic      Topic      @relation(fields: [topicId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([topicId, ingredientId])
  @@map("topic_ingredients")
}

model EvidenceReference {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String?   @map("tenant_id") @db.Uuid
  ingredientId String    @map("ingredient_id") @db.Uuid
  title        String
  source       String?
  url          String?
  summary      String?
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([ingredientId])
  @@map("evidence_references")
}

model Article {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String?  @map("tenant_id") @db.Uuid
  /// Team knowledge (docs/37 §1). Null = the whole tenant (or the platform,
  /// when tenantId is null too). Set = readable by that team and every team
  /// BENEATH it — reading goes up the tree, writing goes down it (docs/37 §2).
  teamId       String?  @map("team_id") @db.Uuid
  slug         String
  title        String
  summary      String?
  body         String
  status       String   @default("published")
  translations Json?
  searchText   String   @default("") @map("search_text")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  topics      ArticleTopic[]
  ingredients ArticleIngredient[]

  @@index([tenantId, teamId, status])
  @@map("articles")
}

model ArticleTopic {
  articleId String @map("article_id") @db.Uuid
  topicId   String @map("topic_id") @db.Uuid

  article Article @relation(fields: [articleId], references: [id])
  topic   Topic   @relation(fields: [topicId], references: [id])

  @@id([articleId, topicId])
  @@map("article_topics")
}

model ArticleIngredient {
  articleId    String @map("article_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid

  article    Article    @relation(fields: [articleId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([articleId, ingredientId])
  @@map("article_ingredients")
}

/// Brands are data, never code (spec §31): a second brand is rows, not a schema change.
model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  code      String
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("brands")
}

model Product {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String?   @map("tenant_id") @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  code           String
  name           String
  description    String?
  sourceUrl      String?   @map("source_url")
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz(6)
  safetyNotes    String?   @map("safety_notes")
  status         String    @default("active")
  translations   Json?
  searchText     String    @default("") @map("search_text")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand       Brand               @relation(fields: [brandId], references: [id])
  ingredients ProductIngredient[]

  @@index([brandId])
  @@map("products")
}

model ProductIngredient {
  productId    String @map("product_id") @db.Uuid
  ingredientId String @map("ingredient_id") @db.Uuid

  product    Product    @relation(fields: [productId], references: [id])
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@id([productId, ingredientId])
  @@map("product_ingredients")
}

// ── AI (docs/12) ──

model AiConversation {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  agent     String   @default("basic-assistant")
  title     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages AiMessage[]

  @@index([tenantId, memberId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String
  content        String
  citations      Json?
  /// Position within the conversation. created_at cannot order a turn: both
  /// messages are written in one transaction and share now().
  ordinal        Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AiConversation @relation(fields: [conversationId], references: [id])

  @@index([tenantId, conversationId, ordinal])
  @@map("ai_messages")
}

model AiUsage {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  memberId     String   @map("member_id") @db.Uuid
  usageDate    DateTime @map("usage_date") @db.Date
  provider     String
  model        String
  requests     Int      @default(0)
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, memberId, usageDate])
  @@index([tenantId, usageDate])
  @@map("ai_usage")
}

// ───────────────────────── Phase 2 — Healthy Living OS ─────────────────────────
// Health data is the most sensitive data in the platform (spec §59): it is
// SELF-scoped by default, never visible to leaders without an explicit grant
// from the member, and free-text notes are encrypted at rest.

model HealthProfile {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  memberId       String   @unique @map("member_id") @db.Uuid
  /// Coarse, member-declared context — never a diagnosis.
  lifestyleNotes String?  @map("lifestyle_notes")
  focusGoalIds   Json     @default("[]") @map("focus_goal_ids")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, memberId])
  @@map("health_profiles")
}

model Habit {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  memberId    String    @map("member_id") @db.Uuid
  code        String
  name        String
  /// 'health' (docs/13 privacy applies) or 'business' (docs/60 — a coach may
  /// see it, which is the entire point of the daily checklist). These are two
  /// different promises and must never be resolved by the same query.
  category    String    @default("health")
  cadence     String    @default("daily")
  targetUnit  String?   @map("target_unit")
  targetValue Decimal?  @map("target_value") @db.Decimal(10, 2)
  status      String    @default("active")
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  logs HabitLog[]

  @@unique([memberId, code])
  @@index([tenantId, memberId, status])
  @@index([tenantId, memberId, category])
  @@map("habits")
}

model HabitLog {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  habitId   String   @map("habit_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  logDate   DateTime @map("log_date") @db.Date
  value     Decimal? @db.Decimal(10, 2)
  completed Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  habit Habit @relation(fields: [habitId], references: [id])

  @@unique([habitId, logDate])
  @@index([tenantId, memberId, logDate])
  @@map("habit_logs")
}

model HealthMetric {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  metric     String
  value      Decimal  @db.Decimal(10, 2)
  unit       String
  measuredOn DateTime @map("measured_on") @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([memberId, metric, measuredOn])
  @@index([tenantId, memberId, metric, measuredOn])
  @@map("health_metrics")
}

/// An explicit, revocable permission from ONE member to ONE other member
/// (a coach or leader) to view their health data (spec §59). Absence of a row
/// means no access — there is no implicit leader access to health data.
model HealthDataGrant {
  id              String    @id @default(uuid(7)) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  memberId        String    @map("member_id") @db.Uuid
  granteeMemberId String    @map("grantee_member_id") @db.Uuid
  scope           String    @default("summary")
  grantedAt       DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)

  @@unique([memberId, granteeMemberId])
  @@index([tenantId, granteeMemberId, revokedAt])
  @@map("health_data_grants")
}

// ───────────────────────── Phase 2 — Community · Challenges · Gamification ─────────────────────────

model Community {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  teamId      String?  @unique @map("team_id") @db.Uuid
  code        String
  name        String
  description String?
  visibility  String   @default("team")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

