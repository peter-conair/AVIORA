  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  community Community  @relation(fields: [communityId], references: [id])
  comments  Comment[]
  reactions Reaction[]

  @@index([tenantId, communityId, pinned, createdAt])
  @@map("posts")
}

model Comment {
  id             String    @id @default(uuid(7)) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  postId         String    @map("post_id") @db.Uuid
  authorMemberId String    @map("author_member_id") @db.Uuid
  body           String
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id])

  @@index([tenantId, postId, createdAt])
  @@map("comments")
}

model Reaction {
  tenantId  String   @map("tenant_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  kind      String   @default("like")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  post Post @relation(fields: [postId], references: [id])

  @@id([postId, memberId, kind])
  @@index([tenantId, postId])
  @@map("reactions")
}

/// A challenge measures progress from data the platform already holds.
/// `source` names WHERE progress comes from; nothing is tracked twice.
model Challenge {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  communityId String?  @map("community_id") @db.Uuid
  code        String
  name        String
  description String?
  /// 'habit' | 'course' | 'goal'
  source      String
  /// habit code, course id, or null — interpreted per source
  sourceRef   String?  @map("source_ref")
  targetValue Int      @map("target_value")
  startsOn    DateTime @map("starts_on") @db.Date
  endsOn      DateTime @map("ends_on") @db.Date
  status      String   @default("open")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  community    Community?             @relation(fields: [communityId], references: [id])
  participants ChallengeParticipant[]

  @@unique([tenantId, code])
  @@index([tenantId, status, endsOn])
  @@map("challenges")
}

/// Joining is the consent step. A habit-sourced challenge derives progress from
/// health data, so a member appears on a leaderboard only because they chose to
/// join — and only the derived count is ever shared, never the underlying logs.
model ChallengeParticipant {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  challengeId String    @map("challenge_id") @db.Uuid
  memberId    String    @map("member_id") @db.Uuid
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt      DateTime? @map("left_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@unique([challengeId, memberId])
  @@index([tenantId, memberId])
  @@map("challenge_participants")
}

/// Points are configuration, not code (spec §38): a tenant decides what an
/// event is worth, and may award none at all.
model GamificationRule {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  eventName String   @map("event_name")
  points    Int      @default(0)
  badgeCode String?  @map("badge_code")
  badgeName String?  @map("badge_name")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, eventName])
  @@map("gamification_rules")
}

/// Append-only: the ledger explains every point a member holds.
model PointEntry {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  memberId    String   @map("member_id") @db.Uuid
  eventName   String   @map("event_name")
  points      Int
  referenceId String?  @map("reference_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, memberId, createdAt])
  @@map("point_entries")
}

model MemberBadge {
  tenantId  String   @map("tenant_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  badgeCode String   @map("badge_code")
  badgeName String   @map("badge_name")
  awardedAt DateTime @default(now()) @map("awarded_at") @db.Timestamptz(6)

  @@id([memberId, badgeCode])
  @@index([tenantId, memberId])
  @@map("member_badges")
}

// ── Commerce (docs/16 Phase 2, spec §39–§40) ──
//
// Money is stored as an integer in the currency's minor unit plus an ISO-4217
// code. No floats, and no assumption that a tenant sells in any one currency.
//
// Knowledge Products stay brand-neutral and may be global; what a TENANT sells
// is an Offering. An Offering may point at a knowledge Product, or stand alone
// (a coaching package, an event seat), which is why the link is optional.

model Offering {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  code               String
  name               String
  description        String?
  /// Optional link to the brand-neutral knowledge product this sells.
  productId          String?  @map("product_id") @db.Uuid
  /// 'one_time' | 'subscription'
  kind               String   @default("one_time")
  currency           String   @db.VarChar(3)
  priceMinor         Int      @map("price_minor")
  status             String   @default("active")
  /// Subscription defaults; any interval, not a fixed enum of billing periods.
  intervalUnit       String?  @map("interval_unit")
  intervalCount      Int?     @map("interval_count")
  translations       Json?
  /// ISO-3166-1 alpha-2 codes this may be sold in. EMPTY MEANS EVERYWHERE —
  /// the common case must not require every tenant to enumerate the world
  /// (docs/29 §5). Checkout is where it refuses.
  availableCountries String[] @default([]) @map("available_countries")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  planPrices    OfferingPlanPrice[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
  subscriptions Subscription[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("offerings")
}

/// Membership pricing: a plan pays a different price. Configuration, so no
/// code ever branches on a plan's name.
model OfferingPlanPrice {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  offeringId String @map("offering_id") @db.Uuid
  planId     String @map("plan_id") @db.Uuid
  priceMinor Int    @map("price_minor")

  offering Offering       @relation(fields: [offeringId], references: [id])
  plan     MembershipPlan @relation(fields: [planId], references: [id])

  @@unique([offeringId, planId])
  @@index([tenantId])
  @@map("offering_plan_prices")
}

model Coupon {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  code             String
  /// 'percent' | 'fixed'
  kind             String
  /// percent: 1–100. fixed: minor units of `currency`.
  value            Int
  currency         String?   @db.VarChar(3)
  minSubtotalMinor Int?      @map("min_subtotal_minor")
  startsAt         DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt           DateTime? @map("ends_at") @db.Timestamptz(6)
  maxRedemptions   Int?      @map("max_redemptions")
  redeemedCount    Int       @default(0) @map("redeemed_count")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  carts  Cart[]
  orders Order[]

  @@unique([tenantId, code])
  @@map("coupons")
}

model Cart {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  /// 'open' | 'ordered' | 'abandoned'
  status    String   @default("open")
  couponId  String?  @map("coupon_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  member Member     @relation(fields: [memberId], references: [id])
  coupon Coupon?    @relation(fields: [couponId], references: [id])
  items  CartItem[]

  @@index([tenantId, memberId, status])
  @@map("carts")
}

model CartItem {
  id             String @id @default(uuid(7)) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  cartId         String @map("cart_id") @db.Uuid
  offeringId     String @map("offering_id") @db.Uuid
  quantity       Int    @default(1)
  /// Snapshot of the resolved price, so a catalogue edit cannot silently
  /// change what the member was looking at.
  unitPriceMinor Int    @map("unit_price_minor")

  cart     Cart     @relation(fields: [cartId], references: [id])
  offering Offering @relation(fields: [offeringId], references: [id])

  @@unique([cartId, offeringId])
  @@index([tenantId])
  @@map("cart_items")
}

model Order {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  memberId           String    @map("member_id") @db.Uuid
  number             String
  /// 'pending' | 'paid' | 'cancelled' | 'refunded'
  status             String    @default("pending")
  currency           String    @db.VarChar(3)
  subtotalMinor      Int       @map("subtotal_minor")
  discountMinor      Int       @default(0) @map("discount_minor")
  totalMinor         Int       @map("total_minor")
  /// What this order was actually charged — never recomputed later.
  taxMinor           Int       @default(0) @map("tax_minor")
  taxLabel           String?   @map("tax_label")
  taxRateBasisPoints Int?      @map("tax_rate_basis_points")
  couponId           String?   @map("coupon_id") @db.Uuid
  subscriptionId     String?   @map("subscription_id") @db.Uuid
  placedAt           DateTime  @default(now()) @map("placed_at") @db.Timestamptz(6)
  paidAt             DateTime? @map("paid_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)

  member       Member        @relation(fields: [memberId], references: [id])
  coupon       Coupon?       @relation(fields: [couponId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  items        OrderItem[]
  payments     Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, memberId, placedAt])
  @@index([tenantId, status])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid(7)) @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  offeringId     String @map("offering_id") @db.Uuid
  /// Name at purchase time — an order must still read correctly after the
  /// catalogue is renamed.
  name           String
  quantity       Int
  unitPriceMinor Int    @map("unit_price_minor")
  lineTotalMinor Int    @map("line_total_minor")

  order    Order    @relation(fields: [orderId], references: [id])
  offering Offering @relation(fields: [offeringId], references: [id])

  @@index([tenantId, orderId])
  @@map("order_items")
}

/// Provider-agnostic payment record. The only adapter shipped is 'manual'
/// (recorded offline/bank transfer); a PSP becomes another provider value.
model Payment {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  provider    String    @default("manual")
  providerRef String?   @map("provider_ref")
  amountMinor Int       @map("amount_minor")
  currency    String    @db.VarChar(3)
  /// 'pending' | 'succeeded' | 'failed'
  status      String    @default("pending")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt   DateTime? @map("settled_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId])
  @@map("payments")
}

model Subscription {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  memberId      String    @map("member_id") @db.Uuid
  offeringId    String    @map("offering_id") @db.Uuid
  /// 'active' | 'paused' | 'cancelled'
  status        String    @default("active")
  /// Any interval: ('day'|'week'|'month') × count. Monthly, quarterly and
  /// custom intervals are all the same code path.
  intervalUnit  String    @map("interval_unit")
  intervalCount Int       @map("interval_count")
  quantity      Int       @default(1)
  currency      String    @db.VarChar(3)
  priceMinor    Int       @map("price_minor")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  /// Date (not instant) the next order is due — billing days are calendar days
  /// in the tenant's own reckoning.
  nextRunOn     DateTime  @map("next_run_on") @db.Date
  pausedAt      DateTime? @map("paused_at") @db.Timestamptz(6)
  cancelledAt   DateTime? @map("cancelled_at") @db.Timestamptz(6)
  autoRenew     Boolean   @default(true) @map("auto_renew")

  member   Member            @relation(fields: [memberId], references: [id])
  offering Offering          @relation(fields: [offeringId], references: [id])
  orders   Order[]
  runs     SubscriptionRun[]

  @@index([tenantId, memberId])
  @@index([tenantId, status, nextRunOn])
  @@map("subscriptions")
}

/// One row per scheduled cycle. The unique key is what makes renewal safe to
/// retry: a run that already produced an order can never produce a second one.
model SubscriptionRun {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  scheduledFor   DateTime @map("scheduled_for") @db.Date
  /// 'ordered' | 'skipped'
  outcome        String
  orderId        String?  @map("order_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, scheduledFor])
  @@index([tenantId])
  @@map("subscription_runs")
}

// ── Growth: referral graph + ranks (docs/25, spec §17–§18, §44) ──
//
// Spec §17 is mandatory: the referral graph is NOT the team graph. It has its
// own table and its own traversal, and shares nothing with team_closure. A
// member may be referred by one person and report to a different leader.

model ReferralRelationship {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  referrerMemberId String    @map("referrer_member_id") @db.Uuid
  referredMemberId String    @map("referred_member_id") @db.Uuid
  /// referral | sponsor | introducer | affiliate | mentor_referral
  relationshipType String    @map("relationship_type")
  effectiveFrom    DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  /// null = active. Ending an edge stamps this instead of deleting the row.
  effectiveTo      DateTime? @map("effective_to") @db.Timestamptz(6)
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  referrer Member @relation("referralsGiven", fields: [referrerMemberId], references: [id])
  referred Member @relation("referralsReceived", fields: [referredMemberId], references: [id])

  @@index([tenantId, referrerMemberId, relationshipType])
  @@index([tenantId, referredMemberId, relationshipType])
  @@map("referral_relationships")
}

model RankDefinition {
  id                   String   @id @default(uuid(7)) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  code                 String
  name                 String
  /// Ordering of the ladder. The highest level whose rules all pass wins.
  level                Int
  status               String   @default("active")
  /// Null = the rank is kept once earned. Otherwise it must still qualify.
  requalifyWindowDays  Int?     @map("requalify_window_days")
  /// Course ids a member working towards this rank can do next (docs/27 §3).
  /// Recommendation only — nothing here gates the rank.
  recommendedCourseIds String[] @map("recommended_course_ids")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  qualifications RankQualification[]
  progress       RankProgress[]
  history        RankHistory[]

  @@unique([tenantId, code])
  @@unique([tenantId, level])
  @@map("rank_definitions")
}

/// A qualification is DATA: metric, comparator, threshold, window. Adding a
/// rank rule is a row, never a branch in code.
model RankQualification {
  id         String @id @default(uuid(7)) @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  rankId     String @map("rank_id") @db.Uuid
  metric     String
  comparator String @default("gte")
  threshold  Int
  /// lifetime | rolling_30 | rolling_90 | calendar_month
  window     String @default("lifetime")
  /// Metric-specific configuration, e.g. { "legVolumeMinor": 500000 }.
  params     Json?

  rank RankDefinition @relation(fields: [rankId], references: [id])

  @@index([tenantId, rankId])
  @@map("rank_qualifications")
}

/// Current state per member: the rank, and the metric snapshot that justified
/// it. Kept so a later commission run can show its working.
model RankProgress {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  memberId    String   @map("member_id") @db.Uuid
  rankId      String?  @map("rank_id") @db.Uuid
  evaluatedAt DateTime @default(now()) @map("evaluated_at") @db.Timestamptz(6)
  metrics     Json

  member Member          @relation(fields: [memberId], references: [id])
  rank   RankDefinition? @relation(fields: [rankId], references: [id])

  @@unique([tenantId, memberId])
  @@map("rank_progress")
}

/// Append-only. A rank is never deleted from history, only closed.
model RankHistory {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  memberId   String    @map("member_id") @db.Uuid
  rankId     String    @map("rank_id") @db.Uuid
  achievedAt DateTime  @default(now()) @map("achieved_at") @db.Timestamptz(6)
  lostAt     DateTime? @map("lost_at") @db.Timestamptz(6)
  /// achieved | requalified | lost
  reason     String

  member Member         @relation(fields: [memberId], references: [id])
  rank   RankDefinition @relation(fields: [rankId], references: [id])

  @@index([tenantId, memberId, achievedAt])
  @@map("rank_history")
}

// ── Compensation (docs/26, spec §42–§43) ──
//
// Spec §42: "Compensation must be optional and tenant configurable. Never
// hard-code one network plan." The eleven bonus types in §43 are all the same
// sentence — IF conditions THEN payout — so `bonusType` is a reporting label,
// not a code path.

/// The THIRD graph (spec §17). A member may be referred by one person and paid
/// under another; this table says who they are paid under, and it reads
/// neither team_closure nor referral_relationships.
model CompensationRelationship {
  id               String    @id @default(uuid(7)) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  uplineMemberId   String    @map("upline_member_id") @db.Uuid
  downlineMemberId String    @map("downline_member_id") @db.Uuid
  effectiveFrom    DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo      DateTime? @map("effective_to") @db.Timestamptz(6)
  metadata         Json?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  upline   Member @relation("compUpline", fields: [uplineMemberId], references: [id])
  downline Member @relation("compDownline", fields: [downlineMemberId], references: [id])

  @@index([tenantId, uplineMemberId])
  @@index([tenantId, downlineMemberId])
  @@map("compensation_relationships")
}

model CompensationPlan {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  code          String
  name          String
  description   String?
  currency      String    @db.VarChar(3)
  status        String    @default("active")
  effectiveFrom DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo   DateTime? @map("effective_to") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  rules CompensationRule[]
  runs  CommissionRun[]

  @@unique([tenantId, code])
  @@map("compensation_plans")
}

model CompensationRule {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  planId     String   @map("plan_id") @db.Uuid
  code       String
  name       String
  /// Reporting label only — fixed_cash, rank, matching, referral, … Nothing
  /// branches on it (docs/26 §1).
  bonusType  String   @map("bonus_type")
  /// [{ metric, comparator, threshold, window, params, graph }]
  conditions Json
  /// { kind: 'fixed' | 'percent', amountMinor? , percent?, basis?, capMinor? }
  payout     Json
  priority   Int      @default(100)
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plan    CompensationPlan  @relation(fields: [planId], references: [id])
  entries CommissionEntry[]

  @@unique([tenantId, planId, code])
  @@index([tenantId, planId, priority])
  @@map("compensation_rules")
}

/// A snapshot of one period. The unique key on the period is what stops a
/// second run — and a second payout — for the same window.
model CommissionRun {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  planId      String    @map("plan_id") @db.Uuid
  periodStart DateTime  @map("period_start") @db.Timestamptz(6)
  periodEnd   DateTime  @map("period_end") @db.Timestamptz(6)
  /// draft | approved
  status      String    @default("draft")
  currency    String    @db.VarChar(3)
  totalMinor  Int       @default(0) @map("total_minor")
  entryCount  Int       @default(0) @map("entry_count")
  computedAt  DateTime  @default(now()) @map("computed_at") @db.Timestamptz(6)
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(6)

  plan    CompensationPlan  @relation(fields: [planId], references: [id])
  entries CommissionEntry[]

  @@unique([tenantId, planId, periodStart, periodEnd])
  @@index([tenantId, status])
  @@map("commission_runs")
}

model CommissionEntry {
  id          String @id @default(uuid(7)) @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  runId       String @map("run_id") @db.Uuid
  memberId    String @map("member_id") @db.Uuid
  ruleId      String @map("rule_id") @db.Uuid
  bonusType   String @map("bonus_type")
  amountMinor Int    @map("amount_minor")
  currency    String @db.VarChar(3)
  /// The exact numbers that produced the amount, so an entry can be explained
  /// a year later without re-running anything.
  basis       Json

  run    CommissionRun    @relation(fields: [runId], references: [id])
  rule   CompensationRule @relation(fields: [ruleId], references: [id])
  member Member           @relation(fields: [memberId], references: [id])

  @@unique([runId, memberId, ruleId])
  @@index([tenantId, memberId])
  @@map("commission_entries")
}

// ── Automation & Rewards (docs/27, spec §51, §45) ──

/// A rule is one more handler on the existing outbox: trigger, conditions,
/// actions. Nothing here is a new pipeline (docs/27 §1).
model AutomationRule {
  id           String @id @default(uuid(7)) @db.Uuid
  tenantId     String @map("tenant_id") @db.Uuid
  code         String
  name         String
  /// An event name from the shared EVENTS catalog; a rule naming an event that
  /// does not exist is refused at creation.
  triggerEvent String @map("trigger_event")
  /// [{ metric | payloadPath, comparator, threshold | value, window, graph }]
  conditions   Json
  /// [{ type, ...config }] — only actions with a real adapter are accepted.
  actions      Json
  priority     Int    @default(100)
  status       String @default("active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  executions AutomationExecution[]

  @@unique([tenantId, code])
  @@index([tenantId, triggerEvent, status])
  @@map("automation_rules")
}

/// One row per (rule, event). The unique key is what stops a replayed event
/// from granting a second reward.
model AutomationExecution {
  id       String  @id @default(uuid(7)) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  ruleId   String  @map("rule_id") @db.Uuid
  eventId  String  @map("event_id") @db.Uuid
  memberId String? @map("member_id") @db.Uuid
  /// success | failed | skipped
  status   String
  result   Json?
  error    String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rule AutomationRule @relation(fields: [ruleId], references: [id])

  @@unique([ruleId, eventId])
  @@index([tenantId, createdAt])
  @@map("automation_executions")
}

model RewardDefinition {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  code     String
  name     String
  /// points | badge | course_access | coupon | membership_upgrade | product |
  /// event_ticket | recognition | certificate | cash
  type     String
  /// Type-specific configuration, e.g. { "points": 50 } or { "courseId": … }.
  config   Json?
  status   String @default("active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  grants RewardGrant[]

  @@unique([tenantId, code])
  @@map("reward_definitions")
}

/// Revocable, never deleted: the history of what was given and taken back is
/// the point of recording a reward at all.
model RewardGrant {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  rewardId   String    @map("reward_id") @db.Uuid
  memberId   String    @map("member_id") @db.Uuid
  /// automation | manual
  sourceType String    @map("source_type")
  /// The rule or actor that caused it.
  sourceRef  String?   @map("source_ref")
  status     String    @default("granted")
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  metadata   Json?

  reward RewardDefinition @relation(fields: [rewardId], references: [id])
  member Member           @relation(fields: [memberId], references: [id])

  @@index([tenantId, memberId, grantedAt])
  @@map("reward_grants")
}

// ── White label & multi-country (docs/29, spec §54–§56) ──

/// Presentation only. `hiddenFeatures` hides navigation and is NOT access
/// control — the permission and entitlement guards refuse; hiding is tidiness.
model TenantBranding {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  appName        String?  @map("app_name")
  logoUrl        String?  @map("logo_url")
  /// { "primary": "#0f766e", "surface": "#f8fafc", … } — data, never CSS.
  colors         Json?
  fontFamily     String?  @map("font_family")
  landing        Json?
  emailFromName  String?  @map("email_from_name")
  emailFooter    String?  @map("email_footer")
  hiddenFeatures String[] @default([]) @map("hidden_features")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_branding")
}

model TenantLocalisation {
  id               String   @id @default(uuid(7)) @db.Uuid
  tenantId         String   @unique @map("tenant_id") @db.Uuid
  /// ISO-3166-1 alpha-2.
  country          String   @db.VarChar(2)
  defaultLocale    String   @default("th") @map("default_locale")
  supportedLocales String[] @default(["th", "en"]) @map("supported_locales")
  currency         String   @db.VarChar(3)
  /// IANA zone. What a "day" means here; storage stays UTC.
  timezone         String   @default("Asia/Bangkok")
  addressFormat    Json?    @map("address_format")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_localisation")
}

/// Immutable once published: an edit is a new version, because rewriting what
/// somebody agreed to after they agreed to it is not an edit.
model LegalDocument {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// terms | privacy | refund | custom
  kind        String
  locale      String
  country     String?  @db.VarChar(2)
  version     Int
  title       String
  body        String
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  acceptances LegalAcceptance[]

  @@unique([tenantId, kind, locale, country, version])
  @@index([tenantId, kind, locale])
  @@map("legal_documents")
}

/// Records WHICH VERSION was accepted. "They accepted the terms" is worthless
/// evidence if nobody can say which terms.
model LegalAcceptance {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  memberId   String   @map("member_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  acceptedAt DateTime @default(now()) @map("accepted_at") @db.Timestamptz(6)
  /// Hashed, never the address itself.
  ipHash     String?  @map("ip_hash")

  document LegalDocument @relation(fields: [documentId], references: [id])
  member   Member        @relation(fields: [memberId], references: [id])

  @@unique([memberId, documentId])
  @@index([tenantId, acceptedAt])
  @@map("legal_acceptances")
}

/// A single configured rate — not a tax engine (docs/29 §4).
model TaxRule {
  id              String  @id @default(uuid(7)) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  country         String  @db.VarChar(2)
  region          String?
  /// Basis points: 700 = 7%. Integers only, like every other rate here.
  rateBasisPoints Int     @map("rate_basis_points")
  inclusive       Boolean @default(false)
  label           String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, country, region])
  @@map("tax_rules")
}

// ── Public API & webhooks (docs/30, spec §77) ──

/// A webhook is one more handler on the existing outbox, not a second event
/// system (docs/30 §1).
model WebhookEndpoint {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  url         String
  description String?
  /// Hashed like a password: a secret the platform can read back is a secret
  /// it is holding for no reason.
  secretHash  String   @map("secret_hash")
  /// Event names this endpoint asked for. No wildcard — a subscription that
  /// silently grows when a new event ships is a subscription nobody agreed to.
  events      String[]
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  deliveries WebhookDelivery[]

  @@index([tenantId, status])
  @@map("webhook_endpoints")
}

/// One row per (endpoint, event). The unique key is what stops a replayed
/// event from notifying twice.
model WebhookDelivery {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  endpointId    String    @map("endpoint_id") @db.Uuid
  eventId       String    @map("event_id") @db.Uuid
  eventName     String    @map("event_name")
  /// pending | delivered | failed
  status        String    @default("pending")
  attempts      Int       @default(0)
  responseCode  Int?      @map("response_code")
  error         String?
  nextAttemptAt DateTime? @map("next_attempt_at") @db.Timestamptz(6)
  deliveredAt   DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@unique([endpointId, eventId])
  @@index([tenantId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model ApiKey {
  id         String    @id @default(uuid(7)) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  /// Shown in listings so two keys can be told apart; the rest is a hash.
  prefix     String
  hash       String
  /// Permission keys. A key can never hold a scope its creator lacked.
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, prefix])
  @@index([tenantId, revokedAt])
  @@map("api_keys")
}

// ── Enterprise SSO & tenant database routing (docs/31, spec §77) ──

/// A federated login AUTHENTICATES; it never authorises. Claims are recorded
/// for an administrator to read, never mapped to permissions (docs/31 §1).
model TenantIdentityProvider {
  id                    String   @id @default(uuid(7)) @db.Uuid
  tenantId              String   @unique @map("tenant_id") @db.Uuid
  /// oidc — SAML is deliberately absent rather than half-built.
  kind                  String   @default("oidc")
  issuer                String
  discoveryUrl          String   @map("discovery_url")
  clientId              String   @map("client_id")
  /// Sealed with AES-256-GCM, not hashed: the token exchange needs the secret
  /// back, so a one-way digest would make federation impossible. Write-only —
  /// no route returns it, and a database dump yields nothing without the key.
  clientSecretEncrypted String   @map("client_secret_encrypted")
  /// Email domains this provider may assert. One that may assert anything may
  /// assert the tenant owner.
  allowedDomains        String[] @default([]) @map("allowed_domains")
  jitProvisioning       Boolean  @default(false) @map("jit_provisioning")
  status                String   @default("active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  logins SsoLogin[]

  @@map("tenant_identity_providers")
}

/// Single-use, expiring. A callback that can be replayed is an account that
/// can be taken over twice.
model SsoLogin {
  id            String    @id @default(uuid(7)) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  providerId    String    @map("provider_id") @db.Uuid
  state         String    @unique
  nonce         String
  codeChallenge String    @map("code_challenge")
  redirectTo    String?   @map("redirect_to")
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(6)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  /// What the IdP asserted, kept for an administrator to inspect. Never used
  /// to grant anything.
  claims        Json?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  provider TenantIdentityProvider @relation(fields: [providerId], references: [id])

  @@index([tenantId, createdAt])
  @@map("sso_logins")
}

/// Where a tenant's rows live. Platform-scope: a tenant cannot move itself.
model TenantDatabase {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @unique @map("tenant_id") @db.Uuid
  /// shared | migrating | dedicated
  status       String    @default("shared")
  /// A reference into the secret store — never a DSN in the database.
  dsnSecretRef String?   @map("dsn_secret_ref")
  migratedAt   DateTime? @map("migrated_at") @db.Timestamptz(6)
  notes        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tenant_databases")
}

// ── Scheduler (docs/35) ──

/// One row per (job, tenant, occurrence). The unique key is what stops a
/// restart mid-run from billing anybody twice, and the row existing at all is
/// what makes "did renewals run last night?" a query rather than a guess.
/// What an alert check last saw (docs/42 §3).
///
/// Platform scope, like `scheduled_job_runs`: alerts are about the platform's
/// own health across every tenant, and a tenant must not read or forge them.
/// It exists only so a check that keeps firing does not send the same email
/// every five minutes — the fastest way to teach somebody to filter alerts
/// into a folder they never open.
model AlertState {
  check         String    @id
  firing        Boolean   @default(false)
  /// The measured value that decided it, kept so an email can say what changed.
  value         String?
  /// When this check first went from quiet to firing in the current episode.
  firingSince   DateTime? @map("firing_since") @db.Timestamptz(6)
  /// When somebody was last told about it — starting, reminding, or clearing.
  lastNotifiedAt DateTime? @map("last_notified_at") @db.Timestamptz(6)
  checkedAt     DateTime  @default(now()) @map("checked_at") @db.Timestamptz(6)

  @@map("alert_states")
}

model ScheduledJobRun {
  id           String    @id @default(uuid(7)) @db.Uuid
  job          String
  /// Null for platform-wide jobs.
  tenantId     String?   @map("tenant_id") @db.Uuid
  /// The occurrence this run is FOR — not the moment work began. A late run
  /// still belongs to the slot it missed.
  scheduledFor DateTime  @map("scheduled_for") @db.Timestamptz(6)
  /// claimed | succeeded | failed | skipped
  status       String    @default("claimed")
  attempts     Int       @default(0)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz(6)
  /// What the job actually did, in its own words.
  outcome      Json?
  error        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([job, tenantId, scheduledFor])
  @@index([job, scheduledFor])
  @@index([status, scheduledFor])
  @@map("scheduled_job_runs")
}

/// The monthly goal sheet (docs/58). One per member per month.
model BusinessGoal {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  /// First day of the month this sheet is for, in the tenant's zone.
  month     DateTime @map("month") @db.Date

  /// The narrative half of the sheet. Stored, never scored.
  shortTerm String?  @map("short_term")
  midTerm   String?  @map("mid_term")
  longTerm  String?  @map("long_term")
  lifeGoal  String?  @map("life_goal")

  /// The numeric half. Volume is in minor units like every other money column.
  volumeTargetMinor  Int? @map("volume_target_minor")
  newPartnersTarget  Int? @map("new_partners_target")
  /// "พัฒนา 5+3" — a coaching convention whose definition belongs to the
  /// business, so its progress is typed rather than computed (docs/58 §3).
  developCustomersTarget Int? @map("develop_customers_target")
  developPartnersTarget  Int? @map("develop_partners_target")
  developCustomersActual Int  @default(0) @map("develop_customers_actual")
  developPartnersActual  Int  @default(0) @map("develop_partners_actual")

  /* ── planning assumptions (docs/69) ────────────────────────────────────
     Used ONLY where a member's own history is too thin to measure a rate.
     Kept on the month's goal rather than in a table of their own, because an
     assumption belongs to the plan that was made with it — last March's guess
     should not quietly steer this month's plan. */
  assumedOrderValueMinor Int? @map("assumed_order_value_minor")
  /// Percent, 1–100: of the names written down, how many get spoken to.
  assumedContactRate     Int? @map("assumed_contact_rate")
  /// Percent, 1–100: of the people spoken to, how many buy.
  assumedConversionRate  Int? @map("assumed_conversion_rate")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id])

  @@unique([tenantId, memberId, month])
  @@index([tenantId, month])
  @@map("business_goals")
}

/// A tracking sheet's columns (docs/59). The Follow Up Sheet, the Diamond
/// Check List and the 6WNY protocol are all rows of this table — their columns
/// are product-specific, so they are tenant data rather than code.
model TrackerTemplate {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  code        String
  name        String
  description String?
  /// What a row on this sheet is about: 'lead' | 'member' | 'customer'.
  subjectType String  @map("subject_type")
  isActive    Boolean @default(true) @map("is_active")
  order       Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  steps   TrackerStep[]
  entries TrackerEntry[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive, order])
  @@map("tracker_templates")
}

/// One column. `stageLabel` groups columns the way 6WNY groups them into
/// "before the course / day 4 / day 7"; a sheet with no stages leaves it null.
model TrackerStep {
  id         String  @id @default(uuid(7)) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  templateId String  @map("template_id") @db.Uuid
  key        String
  label      String
  stageLabel String? @map("stage_label")
  order      Int     @default(0)
  /// When set, this column asks for a NUMBER in this unit rather than a tick —
  /// "ชั่งน้ำหนัก (kg.)" is a measurement, and a tick throws the measurement
  /// away (docs/64 §2).
  captureUnit String? @map("capture_unit")

  template TrackerTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  marks    TrackerMark[]

  @@unique([templateId, key])
  @@index([tenantId, templateId, order])
  @@map("tracker_steps")
}

/// One row: this sheet, applied to this person.
model TrackerEntry {
  id          String  @id @default(uuid(7)) @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  templateId  String  @map("template_id") @db.Uuid
  /// 'lead' | 'member' | 'customer' — matches the template's subjectType.
  subjectType String  @map("subject_type")
  subjectId   String  @map("subject_id") @db.Uuid
  /// Who is working this row; a sheet belongs to the person doing the work.
  ownerMemberId String @map("owner_member_id") @db.Uuid
  /// "LINE 1".."LINE 6" on the Diamond sheet; null everywhere else.
  groupLabel  String? @map("group_label")

  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  /// Denormalised from the marks so "who has stalled" is one indexed query
  /// rather than a scan of every tick (docs/59 §5).
  lastMarkedAt DateTime? @map("last_marked_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  template TrackerTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  marks    TrackerMark[]

  @@unique([tenantId, templateId, subjectType, subjectId])
  @@index([tenantId, templateId, groupLabel])
  @@index([tenantId, ownerMemberId, lastMarkedAt])
  @@map("tracker_entries")
}

/// A tick, with the date it happened and who put it there. The date is the
/// whole reason this is not a boolean column.
model TrackerMark {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  entryId  String   @map("entry_id") @db.Uuid
  stepId   String   @map("step_id") @db.Uuid
  markedAt DateTime @default(now()) @map("marked_at") @db.Timestamptz(6)
  markedByMemberId String? @map("marked_by_member_id") @db.Uuid
  /// The number, for a step that asks for one. Kept beside the date, which is
  /// what makes before-and-after derivable rather than remembered.
  value    Decimal? @db.Decimal(10, 2)
  note     String?

  entry TrackerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  step  TrackerStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([entryId, stepId])
  @@index([tenantId, entryId])
  @@map("tracker_marks")
}

/// The weekly review sheet (docs/61). One per member per week.
///
/// Only the WORDS are stored. Every number on the screen is computed at read
/// time from the goal, the orders and the sheets — a member retyping last
/// week's figure into this week's box is how a paper system loses touch with
/// what actually happened (docs/57 §4).
model WeeklyUpdate {
  id       String   @id @default(uuid(7)) @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  memberId String   @map("member_id") @db.Uuid
  /// The Sunday that starts the week, matching the daily checklist.
  weekOf   DateTime @map("week_of") @db.Date

  progressionNote String? @map("progression_note")
  prospectNote    String? @map("prospect_note")
  planNote        String? @map("plan_note")
  questionNote    String? @map("question_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  member Member @relation(fields: [memberId], references: [id])

  @@unique([tenantId, memberId, weekOf])
  @@index([tenantId, weekOf])
  @@map("weekly_updates")
}

/// A customer's consent to something being done with their data (docs/65).
///
/// Modelled on `HealthDataGrant`: given, revocable, and never deleted so the
/// record of what was agreed survives the withdrawal of it. Unlike that one this
/// is consent to PROCESS rather than permission to view — the customer is not a
/// member and has no account to grant anything from, so the member who took the
/// consent records it and is named.
model CustomerConsent {
  id                 String    @id @default(uuid(7)) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  customerId         String    @map("customer_id") @db.Uuid
  /// 'progress_photo' for now. A purpose per thing consented to, never one
  /// blanket yes — consent to be photographed is not consent to anything else.
  purpose            String
  grantedAt          DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  recordedByMemberId String    @map("recorded_by_member_id") @db.Uuid
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// How it was taken — "signed the form", "said yes on the phone".
  note               String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, purpose])
  @@index([tenantId, customerId, revokedAt])
  @@map("customer_consents")
}

/// A before/after photograph (docs/65).
///
/// The bytes live in object storage; this row is the only way to find them, so
/// deleting the row and the object together is what withdrawing consent means.
model ProgressPhoto {
  id                 String   @id @default(uuid(7)) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  customerId         String   @map("customer_id") @db.Uuid
  /// Which checkpoint on the sheet it belongs to, e.g. `before_photo`.
  stepKey            String   @map("step_key")
  takenAt            DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)
  /// Opaque key in the storage adapter. Never a URL: a URL that works without
  /// passing through this API is a photograph with no access control on it.
  storageKey         String   @map("storage_key")
  contentType        String   @map("content_type")
  byteSize           Int      @map("byte_size")
  uploadedByMemberId String   @map("uploaded_by_member_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, takenAt])
  @@map("progress_photos")
}

/// One month of the SOP grid on the customer index card (docs/66 §4).
///
/// The paper has twelve boxes per customer and a tick in each month they
/// ordered. A tick is only recorded here when the system CANNOT see the order —
/// where a real paid order exists the month is derived from it, because a
/// hand-ticked month that disagrees with the orders table is a month nobody can
/// resolve.
model CustomerMonthOrder {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  year       Int
  /// 1–12.
  month      Int
  note       String?
  markedByMemberId String @map("marked_by_member_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, year, month])
