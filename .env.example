# AVIORA — local development environment (placeholders only; copy to .env and fill)
# Never commit a file containing real secret values.

# --- Database (docker-compose defaults) ---
# Superuser/owner connection — used ONLY for migrations & seeding
AVIORA_DATABASE_URL=postgresql://aviora_owner:change-me-owner@localhost:5439/aviora
# Non-owner app role — RLS enforced; used by the API at runtime
AVIORA_APP_DATABASE_URL=postgresql://aviora_app:change-me-app@localhost:5439/aviora

# --- Redis ---
AVIORA_REDIS_URL=redis://:change-me-redis@localhost:6379

# --- API ---
AVIORA_API_PORT=3021
AVIORA_JWT_ACCESS_SECRET=change-me-32-bytes-min-random-string
AVIORA_JWT_REFRESH_SECRET=change-me-another-32-bytes-random
AVIORA_COOKIE_DOMAIN=localhost

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3021/api/v1
AVIORA_WEB_PORT=3020

# --- Platform bootstrap (seed) ---
AVIORA_SEED_PLATFORM_ADMIN_EMAIL=admin@example.com
AVIORA_SEED_PLATFORM_ADMIN_PASSWORD=change-me-strong-password
AVIORA_SEED_DEV_FIXTURES=false

# --- AI (Phase: AI Lite; leave empty until needed) ---
AVIORA_AI_ANTHROPIC_KEY=

# --- Storage (Cloudflare R2; leave empty for local dev) ---
AVIORA_R2_ACCOUNT_ID=
AVIORA_R2_ACCESS_KEY_ID=
AVIORA_R2_SECRET_ACCESS_KEY=
AVIORA_R2_BUCKET=

# --- PII field encryption (generate: openssl rand -base64 32) ---
AVIORA_PII_ENCRYPTION_KEY=change-me-32-random-bytes-base64-encoded

# --- Public API & webhooks (docs/30) ---
# Root key webhook endpoint secrets are derived from. Falls back to
# AVIORA_JWT_ACCESS_SECRET when unset; set it explicitly in production, because
# rotating the JWT secret would otherwise invalidate every webhook signature.
AVIORA_WEBHOOK_SIGNING_KEY=
# Requests per minute per API key on /api/v1/public/* (default 120).
AVIORA_PUBLIC_RATE_LIMIT=120

# --- Enterprise SSO (docs/31) ---
# Where identity providers send people back. One fixed absolute URL, registered
# with each tenant's IdP. Falls back to AVIORA_API_URL + /auth/sso/callback.
AVIORA_SSO_REDIRECT_URI=http://localhost:3021/api/v1/auth/sso/callback
AVIORA_API_URL=http://localhost:3021/api/v1
# Root key the PKCE verifier is derived from (never stored, never sent).
# Falls back to AVIORA_JWT_ACCESS_SECRET; set it explicitly in production.
AVIORA_SSO_SIGNING_KEY=
# Lets the server fetch a discovery document from a private/loopback address.
# LOCAL DEVELOPMENT ONLY — in production this is the SSRF guard.
AVIORA_SSO_ALLOW_PRIVATE_ISSUER=false

# --- Dedicated tenant databases (docs/31 §2, runbook docs/32) ---
# Destination DSN for the extract/verify CLI. Operator shell only.
AVIORA_TENANT_TARGET_DATABASE_URL=
# A tenant_databases row holds a REFERENCE such as env:AVIORA_TENANT_DSN_ACME;
# the variable it names must be set on every API host before the tenant is
# marked `dedicated`, or the resolver fails closed for that tenant.

# ── Alerting (docs/42) ────────────────────────────────────────────────────────
# Where alert email goes. Unset means alerts are still evaluated and recorded,
# and the sweep logs a warning instead of emailing — never silently.
AVIORA_ALERT_EMAIL=
# Thresholds. Deliberately loose: an alert that fires on a normal Tuesday
# teaches people to ignore alerting, which is worse than having none.
AVIORA_ALERT_OUTBOX_AGE_S=600
AVIORA_ALERT_OUTBOX_FAILING=25
AVIORA_ALERT_STALE_CLAIM_M=30
AVIORA_ALERT_JOB_AGE_H=26
AVIORA_ALERT_WEBHOOK_FAILING=20
AVIORA_ALERT_REMINDER_H=24
